{
  "version": 8,
  "name": "Ecologies of British Columbia",
  "metadata": {"maputnik:renderer": "mlgljs"},
  "sources": {
    "openmaptiles": {
      "type": "vector",
      "url": "https://tiles.openfreemap.org/planet"
    },
    "relief": {
      "type": "raster",
      "tiles": [
        "https://tiles.openfreemap.org/natural_earth/ne2sr/{z}/{x}/{y}.png"
      ],
      "tileSize": 256,
      "maxzoom": 6,
      "attribution": "Natural Earth relief via OpenFreeMap"
    },
    "ecoregions": {
      "type": "geojson",
      "data": "https://seagull006.github.io/exploratory-lab-1/bc_ecoregions.geojson",
      "attribution": "Agriculture and Agri-Food Canada — National Ecological Framework, Ecoregions"
    },
    "terrain": {
      "type": "raster-dem",
      "url": "https://tiles.mapterhorn.com/tilejson.json"
    }
  },
  "glyphs": "https://tiles.openfreemap.org/fonts/{fontstack}/{range}.pbf",
  "layers": [
    {
      "id": "land-background",
      "type": "background",
      "paint": {"background-color": "#f1efe7"}
    },
    {
      "id": "land-relief",
      "type": "raster",
      "source": "relief",
      "paint": {
        "raster-opacity": [
          "interpolate",
          ["linear"],
          ["zoom"],
          4,
          0.5,
          7,
          0.3,
          10,
          0
        ]
      }
    },
    {
      "id": "ecoregion-fill",
      "type": "fill",
      "source": "ecoregions",
      "paint": {
        "fill-color": [
          "step",
          ["zoom"],
          [
            "match",
            ["get", "ecozone_id"],
            4,
            "#9fb4a5",
            9,
            "#b7c39a",
            12,
            "#9eafbf",
            13,
            "#6da699",
            14,
            "#d3b98f",
            "#cfcec3"
          ],
          6,
          [
            "match",
            ["get", "ecoregion_id"],
            64,
            "#475c4b",
            65,
            "#ccd6d0",
            66,
            "#849e8c",
            137,
            "#60673c",
            138,
            "#d3dcc7",
            143,
            "#8c9c5c",
            145,
            "#aebc91",
            173,
            "#405663",
            177,
            "#c9cfda",
            178,
            "#4f6879",
            179,
            "#b3bdcb",
            180,
            "#5e798e",
            181,
            "#9dacbd",
            182,
            "#708aa0",
            183,
            "#879aae",
            185,
            "#3d6658",
            187,
            "#c7dbd9",
            188,
            "#457364",
            189,
            "#bad3d0",
            190,
            "#4d8071",
            191,
            "#adcbc6",
            192,
            "#568d7d",
            193,
            "#a0c3bd",
            194,
            "#5e9a8a",
            195,
            "#92bbb3",
            196,
            "#6aa495",
            197,
            "#85b3a9",
            198,
            "#77512c",
            199,
            "#e3dabf",
            200,
            "#825b31",
            201,
            "#ded3b4",
            202,
            "#8d6436",
            203,
            "#dacba8",
            204,
            "#996e3b",
            205,
            "#d5c49d",
            206,
            "#a4773f",
            207,
            "#d1bd91",
            208,
            "#af8144",
            209,
            "#cdb586",
            210,
            "#b88b4b",
            211,
            "#c8ad7a",
            212,
            "#bc9457",
            213,
            "#c4a56f",
            214,
            "#c09c63",
            [
              "match",
              ["get", "ecozone_id"],
              4,
              "#9fb4a5",
              9,
              "#b7c39a",
              12,
              "#9eafbf",
              13,
              "#6da699",
              14,
              "#d3b98f",
              "#cfcec3"
            ]
          ]
        ],
        "fill-opacity": ["interpolate", ["linear"], ["zoom"], 3, 0.78, 6, 1],
      }
    },
    {
      "id": "glacier-context",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landcover",
      "minzoom": 7,
      "filter": ["==", ["get", "class"], "ice"],
      "paint": {"fill-color": "#f1f7f8", "fill-opacity": 0.74}
    },
    {
      "id": "ecoregion-outlines",
      "type": "line",
      "source": "ecoregions",
      "paint": {
        "line-color": "#5e665c",
        "line-width": [
          "interpolate",
          ["linear"],
          ["zoom"],
          4,
          0.35,
          6,
          0.75,
          9,
          0.9
        ],
        "line-opacity": [
          "interpolate",
          ["linear"],
          ["zoom"],
          4,
          0.25,
          6,
          0.9,
          9,
          1.4
        ]
      }
    },
    {
      "id": "water-context",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "water",
      "filter": ["!=", ["get", "brunnel"], "tunnel"],
      "paint": {"fill-color": "#b7d4d8"}
    },
    {
      "id": "river-context",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "waterway",
      "minzoom": 7,
      "paint": {
        "line-color": "#7faeb9",
        "line-opacity": 0.7,
        "line-width": ["interpolate", ["linear"], ["zoom"], 7, 0.5, 11, 1.5]
      }
    },
    {
      "id": "major-roads-context",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "minzoom": 9,
      "filter": [
        "in",
        ["get", "class"],
        ["literal", ["motorway", "trunk", "primary"]]
      ],
      "paint": {
        "line-color": "#bfb4a1",
        "line-opacity": [
          "interpolate",
          ["linear"],
          ["zoom"],
          9,
          0.18,
          11,
          0.43
        ],
        "line-width": ["interpolate", ["linear"], ["zoom"], 8, 0.35, 12, 1.7]
      }
    },
    {
      "id": "political-boundaries-context",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "boundary",
      "filter": ["in", ["get", "admin_level"], ["literal", [2, 4]]],
      "paint": {
        "line-color": "rgba(243, 9, 9, 1)",
        "line-dasharray": [3, 1.5],
        "line-width": 1,
        "line-opacity": [
          "interpolate",
          ["linear"],
          ["zoom"],
          3,
          1,
          4,
          0.7,
          5,
          0.3,
          6,
          0.2,
          9,
          0.1
        ]
      }
    },
    {
      "id": "water-labels",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "water_name",
      "minzoom": 24,
      "maxzoom": 0,
      "layout": {
        "text-field": ["coalesce", ["get", "name:en"], ["get", "name"]],
        "text-font": ["Noto Sans Italic"],
        "text-size": 11,
        "visibility": "none"
      },
      "paint": {
        "text-color": "#527987",
        "text-halo-color": "#f0eee8",
        "text-halo-width": 1
      }
    },
    {
      "id": "cities-context",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "place",
      "maxzoom": 6,
      "filter": ["in", ["get", "class"], ["literal", ["city", "town"]]],
      "layout": {
        "text-field": ["coalesce", ["get", "name:en"], ["get", "name"]],
        "text-font": ["Noto Sans Regular"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 4, 10, 8, 13],
        "text-max-width": 7,
        "visibility": "visible"
      },
      "paint": {
        "text-color": "#44524b",
        "text-halo-color": "#f0eee8",
        "text-halo-width": 1.3
      }
    },
    {
      "id": "village-context",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "place",
      "minzoom": 24,
      "maxzoom": 0,
      "filter": ["==", ["get", "class"], "village"],
      "layout": {
        "text-field": ["coalesce", ["get", "name:en"], ["get", "name"]],
        "text-font": ["Noto Sans Regular"],
        "text-size": 11,
        "visibility": "none"
      },
      "paint": {
        "text-color": "#64726b",
        "text-halo-color": "#f0eee8",
        "text-halo-width": 1
      }
    },
    {
      "id": "ecoregion-names",
      "type": "symbol",
      "source": "ecoregions",
      "minzoom": 6,
      "layout": {
        "text-field": ["get", "name"],
        "text-font": ["Noto Sans Regular"],
        "text-size": [
          "interpolate",
          ["linear"],
          ["zoom"],
          6,
          12,
          9,
          14,
          11,
          16
        ],
        "text-max-width": 12,
        "text-padding": 5
      },
      "paint": {
        "text-color": "#35433b",
        "text-halo-color": "#f8f8f2",
        "text-halo-width": 1.4,
        "text-opacity": 0.85
      }
    },
    {
      "id": "terrain-hillshade",
      "type": "hillshade",
      "source": "terrain",
      "minzoom": 4,
      "maxzoom": 9,
      "paint": {"hillshade-exaggeration": 0.2}
    }
  ],
  "id": "vsc6jjc"
}
