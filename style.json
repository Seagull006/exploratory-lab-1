{
  "version": 8,
  "name": "Ecologies of British Columbia",
  "sources": {
    "openmaptiles": {
      "type": "vector",
      "url": "https://tiles.openfreemap.org/planet"
    },
    "relief": {
      "type": "raster",
      "tiles": [
        "https://tiles.openfreemap.org/natural_earth/ne2sr/{z}/{x}/{y}.png"
      ],
      "tileSize": 256,
      "maxzoom": 6,
      "attribution": "Natural Earth relief via OpenFreeMap"
    },
    "ecoregions": {
      "type": "geojson",
      "data": "https://seagull006.github.io/seagull006-web/bc_ecoregions.geojson",
      "attribution": "Agriculture and Agri-Food Canada \u2014 National Ecological Framework, Ecoregions"
    }
  },
  "glyphs": "https://tiles.openfreemap.org/fonts/{fontstack}/{range}.pbf",
  "layers": [
    {
      "id": "land-background",
      "type": "background",
      "paint": {
        "background-color": "#f1efe7"
      }
    },
    {
      "id": "land-relief",
      "type": "raster",
      "source": "relief",
      "paint": {
        "raster-opacity": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          4,
          0.25,
          7,
          0.23,
          10,
          0.0
        ]
      }
    },
    {
      "id": "ecoregion-fill",
      "type": "fill",
      "source": "ecoregions",
      "paint": {
        "fill-color": [
          "match",
          [
            "get",
            "ecozone_id"
          ],
          4,
          "#9fb4a5",
          9,
          "#b7c39a",
          12,
          "#9eafbf",
          13,
          "#6da699",
          14,
          "#d3b98f",
          "#cfcec3"
        ],
        "fill-opacity": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          4,
          0.79,
          7,
          0.65,
          10,
          0.5
        ]
      }
    },
    {
      "id": "glacier-context",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landcover",
      "minzoom": 7,
      "filter": [
        "==",
        [
          "get",
          "class"
        ],
        "ice"
      ],
      "paint": {
        "fill-color": "#f1f7f8",
        "fill-opacity": 0.74
      }
    },
    {
      "id": "ecoregion-outlines",
      "type": "line",
      "source": "ecoregions",
      "paint": {
        "line-color": "#5e665c",
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          4,
          0.25,
          7,
          0.6,
          10,
          1.05
        ],
        "line-opacity": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          4,
          0.45,
          8,
          0.68
        ]
      }
    },
    {
      "id": "water-context",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "water",
      "filter": [
        "!=",
        [
          "get",
          "brunnel"
        ],
        "tunnel"
      ],
      "paint": {
        "fill-color": "#b7d4d8"
      }
    },
    {
      "id": "river-context",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "waterway",
      "minzoom": 7,
      "paint": {
        "line-color": "#7faeb9",
        "line-opacity": 0.7,
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          7,
          0.5,
          11,
          1.5
        ]
      }
    },
    {
      "id": "major-roads-context",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "minzoom": 9,
      "filter": [
        "in",
        [
          "get",
          "class"
        ],
        [
          "literal",
          [
            "motorway",
            "trunk",
            "primary"
          ]
        ]
      ],
      "paint": {
        "line-color": "#bfb4a1",
        "line-opacity": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          9,
          0.18,
          11,
          0.43
        ],
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          8,
          0.35,
          12,
          1.7
        ]
      }
    },
    {
      "id": "political-boundaries-context",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "boundary",
      "filter": [
        "in",
        [
          "get",
          "admin_level"
        ],
        [
          "literal",
          [
            2,
            4
          ]
        ]
      ],
      "paint": {
        "line-color": "#7d837e",
        "line-opacity": 0.4,
        "line-dasharray": [
          3,
          1.5
        ],
        "line-width": 0.65
      }
    },
    {
      "id": "water-labels",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "water_name",
      "minzoom": 7,
      "layout": {
        "text-field": [
          "coalesce",
          [
            "get",
            "name:en"
          ],
          [
            "get",
            "name"
          ]
        ],
        "text-font": [
          "Noto Sans Italic"
        ],
        "text-size": 11
      },
      "paint": {
        "text-color": "#527987",
        "text-halo-color": "#f0eee8",
        "text-halo-width": 1
      }
    },
    {
      "id": "cities-context",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "place",
      "filter": [
        "in",
        [
          "get",
          "class"
        ],
        [
          "literal",
          [
            "city",
            "town"
          ]
        ]
      ],
      "layout": {
        "text-field": [
          "coalesce",
          [
            "get",
            "name:en"
          ],
          [
            "get",
            "name"
          ]
        ],
        "text-font": [
          "Noto Sans Regular"
        ],
        "text-size": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          4,
          10,
          8,
          13
        ],
        "text-max-width": 7
      },
      "paint": {
        "text-color": "#44524b",
        "text-halo-color": "#f0eee8",
        "text-halo-width": 1.3
      }
    },
    {
      "id": "village-context",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "place",
      "minzoom": 9,
      "filter": [
        "==",
        [
          "get",
          "class"
        ],
        "village"
      ],
      "layout": {
        "text-field": [
          "coalesce",
          [
            "get",
            "name:en"
          ],
          [
            "get",
            "name"
          ]
        ],
        "text-font": [
          "Noto Sans Regular"
        ],
        "text-size": 11
      },
      "paint": {
        "text-color": "#64726b",
        "text-halo-color": "#f0eee8",
        "text-halo-width": 1
      }
    },
    {
      "id": "ecoregion-names",
      "type": "symbol",
      "source": "ecoregions",
      "minzoom": 8,
      "layout": {
        "text-field": [
          "get",
          "name"
        ],
        "text-font": [
          "Noto Sans Regular"
        ],
        "text-size": 11,
        "text-max-width": 12,
        "text-padding": 5
      },
      "paint": {
        "text-color": "#35433b",
        "text-halo-color": "#f8f8f2",
        "text-halo-width": 1.4,
        "text-opacity": 0.85
      }
    }
  ]
}